# Health Collaboration OS — environment template
# Copy to .env for local use. NEVER commit real secrets.
# Phase 0: no runtime services are started. Placeholders only.

# --- Runtime ---
NODE_ENV=development
LOG_LEVEL=info

# --- API shell (not started in Phase 0) ---
API_PORT=3000
# CORS: never use wildcard in shared/non-local environments.
# Phase 0 has no HTTP server. When added, allowlist explicit origins only.
API_CORS_ORIGINS=http://localhost:3000

# --- Database (NOT provisioned in Phase 0 — Phase 2) ---
# DATABASE_URL=postgresql://user:password@localhost:5432/health_os
# APP_DB_ROLE=
# MIGRATOR_DB_ROLE=

# --- Auth (NOT implemented in Phase 0 — Phase 3) ---
# SESSION_SECRET=
# INVITE_TOKEN_PEPPER=

# --- AI providers (NOT configured in Phase 0 — Phases 9–10; require legal review ADR-0003) ---
# AI_PROVIDER=
# AI_API_KEY=
# AI_REGION=

# --- Storage (NOT implemented — Phase 6) ---
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
