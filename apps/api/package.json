    "@health-os/permissions": "workspace:*",
    "@health-os/validation": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
